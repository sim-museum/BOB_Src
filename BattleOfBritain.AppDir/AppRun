#!/usr/bin/env bash
# Self-contained launcher. The AppImage mount is READ-ONLY and this game writes saves,
# settings.cfg and campaign state into its own data tree, so the bundled data is
# materialised into a writable per-user directory on first run.
set -euo pipefail
HERE="$(dirname "$(readlink -f "$0")")"
export LD_LIBRARY_PATH="$HERE/usr/lib/i386-linux-gnu:${LD_LIBRARY_PATH:-}"

if ! [ -e /lib/ld-linux.so.2 ]; then
  cat >&2 <<'MSG'
Battle of Britain is a 32-bit (i386) build, and this machine has no i386 runtime.
Install the multiarch runtime once:

    sudo dpkg --add-architecture i386 && sudo apt update
    sudo apt install libc6:i386 libstdc++6:i386 libgl1:i386

On NVIDIA also install the i386 GL for your driver, e.g.:
    sudo apt install libnvidia-gl-595:i386        # match your installed driver version

GL and libc cannot be bundled: they are tied to your kernel and graphics driver.
MSG
  exit 1
fi

DEST="${BOB_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/battle-of-britain}"
if [ ! -e "$DEST/.installed" ]; then
  echo "First run: installing game data into $DEST (about 1.2 GB, once)..." >&2
  mkdir -p "$DEST"
  cp -a --reflink=auto "$HERE/usr/share/bob/drive_c" "$DEST/" 2>/dev/null || cp -a "$HERE/usr/share/bob/drive_c" "$DEST/"
  chmod -R u+w "$DEST/drive_c"
  touch "$DEST/.installed"
fi

export BOB_DRIVE_C="$DEST/drive_c"
GAMEDIR="$BOB_DRIVE_C/Program Files/Rowan Software/Battle Of Britain"
cd "$GAMEDIR" || { echo "game dir missing: $GAMEDIR" >&2; exit 1; }
exec "$HERE/usr/bin/bob" "$@"
